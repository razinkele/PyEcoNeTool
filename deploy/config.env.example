# Deploy target for deploy/deploy.sh.
# Copy this file to deploy/config.env (which is gitignored) and set your values.
#
#   cp deploy/config.env.example deploy/config.env
#   # then edit deploy/config.env
#
# DEPLOY_SERVER — SSH destination with passwordless (key-based) access.
# DEPLOY_DIR    — the Shiny Server app directory on that host.
# DEPLOY_PYTHON — interpreter Shiny Server runs the app with; deploy.sh uses
#                 the same one for the pickle rebuild and the import smoke, so
#                 those checks test what production actually runs.

DEPLOY_SERVER=user@host
DEPLOY_DIR=/srv/shiny-server/EconetPy
DEPLOY_PYTHON=/opt/micromamba/envs/shiny/bin/python3

# DEPLOY_NGINX_VHOST  — the /etc/nginx/sites-available/<name> file to patch.
# DEPLOY_STAGE_DIR    — where render-configs.sh --stage puts the rendered
#                       configs on the server, ready for the sudo cp steps.
# DEPLOY_ANCHOR_APP   — an existing app whose config block the EconetPy block
#                       is inserted after.
DEPLOY_NGINX_VHOST=your-vhost-name
DEPLOY_STAGE_DIR=~/econetpy-deploy
DEPLOY_ANCHOR_APP=SESPy
